# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.

# URL công khai của app (HTTPS khi chạy thật — Meta bắt buộc HTTPS cho OAuth redirect & webhook)
APP_BASE_URL=http://localhost:8000

# Chuỗi ngẫu nhiên dài để ký cookie phiên:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Lấy ở developers.facebook.com > App > Settings > Basic
META_APP_ID=
META_APP_SECRET=
# Kiểm tra phiên bản Graph API mới nhất trong App Dashboard rồi cập nhật
META_GRAPH_VERSION=v24.0
# Tùy chọn: dùng "Facebook Login for Business" (configuration_id) thay cho danh sách scope
META_LOGIN_CONFIG_ID=
# Chuỗi tự đặt, nhập giống hệt khi cấu hình Webhook trong App Dashboard
META_WEBHOOK_VERIFY_TOKEN=change-me

# Khóa mã hóa token (Fernet). Tạo:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Xoay khóa: đặt khóa MỚI lên đầu, giữ khóa cũ phía sau, cách nhau bằng dấu phẩy.
TOKEN_ENCRYPTION_KEYS=

# Dev: SQLite. Production: postgresql+psycopg://user:pass@localhost:5432/spm
DATABASE_URL=sqlite:///./spm.db

MEDIA_DIR=./media
DEFAULT_TIMEZONE=Asia/Taipei
